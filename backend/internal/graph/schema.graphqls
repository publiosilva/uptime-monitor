type Monitor {
  id: ID!
  name: String!
  isUp: Boolean!
  stats24h: MonitorStats!
}

type MonitorStats {
  uptimePercentage: Float!
  averageLatencyMs: Float!
  history: [Heartbeat!]!
}

type Heartbeat {
  id: ID!
  statusCode: Int!
  latencyMs: Int!
  isUp: Boolean!
  createdAt: String!
}

type Query {
  getMonitorStats(monitorID: ID!): Monitor!
}
