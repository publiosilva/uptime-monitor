    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch API",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/api",
            "env": {
                "DATABASE_URL": "postgres://uptime:uptime@localhost:5432/uptime_monitor?sslmode=disable",
                "JWT_SECRET": "change-me-in-production"
            }
        },
        {
            "name": "Launch Worker",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/worker",
            "env": {
                "DATABASE_URL": "postgres://uptime:uptime@localhost:5432/uptime_monitor?sslmode=disable",
                "JWT_SECRET": "change-me-in-production"
            }
        }
    ]
}