type Monitor {
  id: ID!
  name: String!
  url: String!
  method: String!
  timeout: Int!
  frequency: Int!
  isActive: Boolean!
  isUp: Boolean!
  createdAt: String!
  stats24h: MonitorStats!
}

type MonitorStats {
  uptimePercentage: Float!
  averageLatencyMs: Float!
  history: [Heartbeat!]!
}

type Heartbeat {
  id: ID!
  statusCode: Int!
  latencyMs: Int!
  isUp: Boolean!
  createdAt: String!
}

type Query {
  getMonitorStats(monitor_id: ID!): Monitor!
}
